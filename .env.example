# Local development. For production, use your exact HTTPS origin with no path.
APP_URL=http://localhost:3000
PORT=3000
DATA_DIR=./data
NODE_ENV=development
# Set your real contact to enable Web Push. This is not a provider API key.
# PUSH_CONTACT=mailto:you@yourdomain.com
# Optional one-time bootstrap on a brand-new database. Remove these after setup.
# ADMIN_USERNAME=owner
# ADMIN_PASSWORD=
