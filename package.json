{
  "name": "wingfactor-support-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test --test-concurrency=1",
    "check": "node --check server/app.js && node --check server/store.js && node --check public/app.js && node --check public/sw.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js"
  },
  "dependencies": {
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "jsdom": "^30.1.3"
  }
}
